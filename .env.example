# Copy to backend/.env for development; set the same names on the host.

# Neon -> Connect -> pooled connection string. Holds the database password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# The website, for links back to it, and who may call from a browser.
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://toolpit.app,https://www.toolpit.app
PORT=8787
# Confirmation and password-reset emails via resend.com. Sign-up needs one of
# these: RESEND_API_KEY, or MAIL_TRANSPORT=capture for local development
# (emails written to .mail/, never sent).
RESEND_API_KEY=
EMAIL_FROM=Toolpit <no-reply@toolpit.app>
# Shared secret pasted into RevenueCat -> Integrations -> Webhooks -> Authorization.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ACCEPT_SANDBOX=false

# Website purchases through Lemon Squeezy (src/payments/lemonsqueezy.ts).
# All of these must be set, or the website keeps checkout closed.
PAYMENT_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Paste the same value into Lemon Squeezy -> Settings -> Webhooks -> Signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
# One Lemon Squeezy variant id per token pack (single-payment products).
LEMONSQUEEZY_VARIANT_TOKENS_30=
LEMONSQUEEZY_VARIANT_TOKENS_100=
LEMONSQUEEZY_VARIANT_TOKENS_500=
LEMONSQUEEZY_VARIANT_TOKENS_1500=
# true only while testing with a TEST-MODE key: test orders then grant tokens.
PAYMENTS_ACCEPT_TEST_MODE=false
MAIL_TRANSPORT=
