# Copy to backend/.env for development; set the same names on the host.

# Neon -> Connect -> pooled connection string. Holds the database password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# The website, for links back to it, and who may call from a browser.
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://toolpit.app,https://www.toolpit.app
PORT=8787
# Password-reset emails via resend.com (optional).
RESEND_API_KEY=
EMAIL_FROM=Toolpit <no-reply@toolpit.app>
# Shared secret pasted into RevenueCat -> Integrations -> Webhooks -> Authorization.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ACCEPT_SANDBOX=false
